# Base URL of the Sahai API Gateway. NHCX signs in against the same `auth`
# Lambda as the main Sahai app, so this normally points at the same gateway.
# If unset, src/services/apiConfig.ts falls back to this value anyway so the
# app still boots on a fresh clone.
VITE_API_BASE_URL=https://1edaydqcf4.execute-api.ap-southeast-1.amazonaws.com

# Optional — WebSocket API for realtime features.
VITE_WEBSOCKET_URL=

# Optional — omit and the Google sign-in button is simply not rendered.
VITE_GOOGLE_CLIENT_ID=
