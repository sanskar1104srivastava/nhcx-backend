# NHCX credentials (already issued)
NHCX_CLIENT_ID=
NHCX_CLIENT_SECRET=
NHCX_PARTICIPANT_CODE=your_code@hcx

# Endpoints (§0 — production base URLs not yet confirmed, sandbox only)
ABDM_SESSIONS_URL=https://dev.abdm.gov.in/gateway/v0.5/sessions
NHCX_GATEWAY_BASE=https://apisbx.abdm.gov.in/hcx/v1
NHCX_PARTICIPANT_BASE=https://apisbx.abdm.gov.in/pmjay/sbxhcx/participanthcxservice
NHCX_DUMMY_PAYER_BASE=https://apisbx.abdm.gov.in/pmjay/sbxhcx/dummyhcxpayer

# Our public bridge URL (receiver)
NHCX_BRIDGE_URL=https://our-bridge.example.com

# §4a/4b — NHA docs disagree; flip these if first sandbox call returns NHCX-1011
NHCX_STATUS_PRESET=initiated        # initiated | initiate
NHCX_TIMESTAMP_PRESET=iso           # iso | epoch_ms

# Private key: secrets manager name (prod) OR local file path (dev). Path wins if set.
NHCX_PRIVATE_KEY_SECRET_NAME=nhcx/private-key
NHCX_PRIVATE_KEY_PATH=

DYNAMO_TABLE_NAME=nhcxRequestLog
DYNAMO_ENDPOINT_URL=              # set to http://localhost:8001 for DynamoDB Local (our own API already uses :8000); blank = real AWS
INBOUND_QUEUE_URL=                # blank locally — receiver processes inline instead of via SQS
AWS_REGION=ap-south-1

# Sandbox test fixtures
NHCX_DUMMY_PAYER_CODE=1000003538@hcx

# §11 — gates /test0, /sandbox, /logs, /send. Blank = open (local dev). Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_API_KEY=
